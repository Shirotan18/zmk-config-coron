/* coron.keymap */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角


&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <99>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        /* Note: Key positions have shifted due to added columns. 
           You will need to recalculate these indices later. */

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        double_quotation {
            bindings = <&kp JP_DQUOTE>; /* 修正：JIS定義コードへ最適化 */
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp JP_EQUAL>; /* 修正：JIS定義コードへ最適化 */
            key-positions = <24 25>;
        };
        question {
            bindings = <&kp QUESTION>; /* QUESTION はZMK標準のままでJISでも「？」になります */
            key-positions = <38 39>;
        };
        muhenkan {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <7 8>;
        };
        combo_key_23_24 {
            bindings = <&kp SEMICOLON>;
            key-positions = <23 24>;
        };

        click_left {
            bindings = <&mkp MB1>;
            key-positions = <21 22>;
        };

        click_right {
            bindings = <&mkp MB2>;
            key-positions = <22 23>;
        };

        click_middle {
            bindings = <&mkp MB3>;
            key-positions = <22 36>;
        };

        to_scroll_layer {
            bindings = <&mo 5>;
            key-positions = <21 22 23>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        sl_under: slash_underscore {
            compatible = "zmk,behavior-mod-morph";
            label = "SLASH_UNDERSCORE";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp JP_UNDERSCORE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_bracket: lt_bracket {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_KAGI_BRACKET";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* ESCの連打・スロット現象を完全に封殺するタップダンス定義 */
        td_esc: td_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_ESC";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp JP_HANZEN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&td_esc         &kp Q         &kp W         &kp E                     &kp R        &kp T                                                                                     &kp Y          &kp U          &kp I      &kp O    &kp P          &mt TILDE MINUS
&kp TAB         &kp A         &kp S         &kp D                     &kp F        &kp G             &trans                                                   &kp MINUS      &kp H          &kp J          &kp K        &kp L    &kp SEMI       &kp ENTER
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C                     &kp V        &kp B             &kp JP_COLON                                             &kp LA(SPACE)  &kp N          &kp M          &kp COMMA    &kp DOT  &sl_under      &kp RIGHT_SHIFT
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &kp INT_MUHENKAN          &lt 3 SPACE  &lt 2 INT_HENKAN  &lt_to_layer_0 4 INT_MUHENKAN                            &kp BACKSPACE  &lt 1 SPACE    &kp DEL        &kp LS(EQUAL)
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans  &trans  &kp JP_TILDE       &kp JP_PIPE    &kp JP_CARET     &kp JP_AT
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &trans  &kp JP_COLON       &kp SEMICOLON  &kp JP_ASTERISK  &kp QUESTION     &kp JP_PLUS  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &kp JP_UNDERSCORE  &kp JP_YEN     &kp JP_LBRACKET  &kp JP_RBRACKET  &trans       &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans             &trans         &trans
            >;
        };

        NUM {
            bindings = <
&trans  &kp EXCLAMATION  &kp JP_DQUOTE  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp JP_AMPERSAND  &kp JP_QUOTE  &kp JP_LPAREN  &kp JP_RPAREN  &kp JP_EQUAL  &kp JP_TILDE
&trans  &kp N1           &kp N2         &kp N3    &kp N4      &kp N5       &trans            &trans        &kp N6         &kp N7         &kp N8        &kp N9       &kp N0  &trans
&trans  &trans           &trans         &trans    &trans      &trans       &trans            &trans        &trans         &trans         &kp COMMA     &kp PERIOD   &kp KP_SLASH  &trans
&trans  &trans           &trans         &trans    &trans      &trans       &trans            &trans        &trans         &trans         &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &lt_bracket JP_LBRACKET JP_LPAREN  &lt_bracket JP_RBRACKET JP_RPAREN  &trans  &kp LC(HOME)  &kp HOME    &kp UP_ARROW        &kp END         &kp LC(END)     &trans
&trans  &trans  &trans  &kp JP_UNDERSCORE                  &trans                             &trans  &trans        &trans      &kp LC(LEFT_ARROW)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(RIGHT_ARROW)  &kp LA(ENTER)
&trans  &trans  &trans  &kp LBKT                           &kp RIGHT_BRACKET                  &trans  &trans        &trans      &trans              &kp F2          &trans          &trans           &trans               &trans
&trans  &trans  &trans  &trans                             &trans                             &trans  &trans        &kp DELETE  &trans              &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans        &trans        &trans        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans          &trans       &trans  &trans
&trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans        &bootloader   &trans        &trans          &trans       &trans  &bt BT_CLR
&trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans                &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RPAR  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
